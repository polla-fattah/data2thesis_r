[#NormalTok("  ");#FunctionTok("mutate");#NormalTok("(");#AttributeTok("sample_size =");#NormalTok(" ");#FunctionTok("paste");#NormalTok("(n, ");#StringTok("\"students\"");#NormalTok("))");],
[],
[#NormalTok("sampling_results ");#SpecialCharTok("|>");],
