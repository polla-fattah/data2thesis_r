[#NormalTok("5                150  0.97");],));
]
]
#Skylighting(([#NormalTok("power_curve ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("data.frame");#NormalTok("(");#AttributeTok("n =");#NormalTok(" ");#DecValTok("5");#SpecialCharTok(":");#DecValTok("160");#NormalTok(")");],
