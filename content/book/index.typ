[#NormalTok("                ");#AttributeTok("mean =");#NormalTok(" ");#FunctionTok("mean");#NormalTok("(.data[[input");#SpecialCharTok("$");#NormalTok("measure]], ");#AttributeTok("na.rm =");#NormalTok(" ");#ConstantTok("TRUE");#NormalTok("),");],
