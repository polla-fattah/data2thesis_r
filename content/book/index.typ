]
#figure([
#box(image("14-advanced-clustering_files/figure-typst/fig-uncertainty-1.svg", alt: "Scatter plot of students on two principal components, coloured by three clusters. Most points are small; the larger points, marking uncertain students, lie along the boundaries where the clusters meet."))
], caption: figure.caption(
position: bottom, 
[
The three mixture model clusters on the first two principal components. Larger points are students whose profile is more uncertain.
]), 
kind: "quarto-float-fig", 
