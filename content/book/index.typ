[#FunctionTok("collect_metrics");#NormalTok("(final_net)");],));
#block[
#Skylighting(([#NormalTok("# A tibble: 2 × 4");],
[#NormalTok("  .metric  .estimator .estimate .config        ");],
[#NormalTok("  <chr>    <chr>          <dbl> <chr>          ");],
[#NormalTok("1 accuracy binary         0.841 pre0_mod0_post0");],
[#NormalTok("2 roc_auc  binary         0.853 pre0_mod0_post0");],));
]
