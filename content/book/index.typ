[#NormalTok("  Statistical Software, 67(1), 1-48. doi:10.18637/jss.v067.i01.");],
[],
[#NormalTok("A BibTeX entry for LaTeX users is");],
[],
[#NormalTok("  @Article{,");],
[#NormalTok("    title = {Fitting Linear Mixed-Effects Models Using {lme4}},");],
[#NormalTok("    author = {Douglas Bates and Martin M{\\\"a}chler and Ben Bolker and Steve Walker},");],
[#NormalTok("    journal = {Journal of Statistical Software},");],
