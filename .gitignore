.codegpt

# Quarto build output (regenerated on every build)
_site/
**/.quarto/
**/site_libs/
# ...except inside _freeze, which Quarto needs to rebuild without R
!**/_freeze/site_libs/
*_files/
site/index.html
site/playground/*.html
book/*.html

# Copied in by site/copy_resources.ts before each build
site/playground/*.csv
site/downloads/
